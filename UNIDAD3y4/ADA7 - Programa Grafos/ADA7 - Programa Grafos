import tkinter as tk
import math
import heapq
import itertools
from collections import defaultdict

# ═══════════════════════════════════════════════════════════
#  DATOS DEL GRAFO
# ═══════════════════════════════════════════════════════════

ESTADOS = [
    "Mérida",
    "Campeche",
    "Villahermosa",
    "Veracruz",
    "Oaxaca",
    "Puebla",
    "CDMX",
]

# Aristas: (estado_a, estado_b, costo_km)
ARISTAS = [
    ("Mérida",       "Campeche",      197),
    ("Campeche",     "Villahermosa",  444),
    ("Villahermosa", "Veracruz",      516),
    ("Veracruz",     "Oaxaca",        341),
    ("Oaxaca",       "Puebla",        363),
    ("Puebla",       "CDMX",          131),
    ("Mérida",       "Villahermosa",  535),
    ("Campeche",     "Oaxaca",        700),
    ("Veracruz",     "Puebla",        300),
    ("Puebla",       "Oaxaca",        363),
    ("CDMX",         "Veracruz",      420),
    ("CDMX",         "Oaxaca",        470),
]

# Posiciones base para dibujar (se escalan al canvas dinámicamente)
POSICIONES = {
    "Mérida":       (520, 70),
    "Campeche":     (400, 155),
    "Villahermosa": (295, 85),
    "Veracruz":     (195, 175),
    "Oaxaca":       (200, 310),
    "Puebla":       (110, 215),
    "CDMX":         (75,  315),
}

# ═══════════════════════════════════════════════════════════
#  LÓGICA DE GRAFOS
# ═══════════════════════════════════════════════════════════

def construir_grafo():
    g = defaultdict(dict)
    for u, v, w in ARISTAS:
        g[u][v] = w
        g[v][u] = w
    return g


GRAFO = construir_grafo()


def hamiltoniano_sin_repeticion(inicio="Mérida"):
    """
    Inciso a): Recorre los 7 estados exactamente una vez.
    Fuerza bruta O(6!) = 720 permutaciones.
    Devuelve (camino_lista, costo_total).
    """
    otros = [e for e in ESTADOS if e != inicio]
    mejor_camino = None
    mejor_costo  = math.inf

    for perm in itertools.permutations(otros):
        ruta  = [inicio] + list(perm)
        costo = 0
        valido = True
        for i in range(len(ruta) - 1):
            u, v = ruta[i], ruta[i + 1]
            if v in GRAFO[u]:
                costo += GRAFO[u][v]
            else:
                valido = False
                break
        if valido and costo < mejor_costo:
            mejor_costo  = costo
            mejor_camino = ruta

    return mejor_camino, mejor_costo


def hamiltoniano_con_repeticion(inicio="Mérida"):
    """
    Inciso b): Visita los 7 estados pudiendo repetir nodos.
    Dijkstra sobre (nodo, frozenset_visitados).
    Busca el camino de menor costo que cubra todos los estados
    y tenga al menos un nodo repetido (len(camino) > 7).
    """
    meta = frozenset(ESTADOS)

    # heap: (costo, nodo, visitados, camino)
    heap = [(0, inicio, frozenset([inicio]), [inicio])]
    dist = defaultdict(lambda: defaultdict(lambda: math.inf))
    dist[inicio][frozenset([inicio])] = 0

    mejor_rep = (None, math.inf)

    while heap:
        costo, nodo, visitados, camino = heapq.heappop(heap)

        if costo > dist[nodo][visitados]:
            continue

        if visitados == meta:
            # Camino completo: ¿tiene repetición?
            if len(camino) > len(ESTADOS) and costo < mejor_rep[1]:
                mejor_rep = (list(camino), costo)
            # No expandir nodos ya completados
            continue

        # Poda: supera el mejor encontrado
        if costo >= mejor_rep[1]:
            continue

        for vecino, peso in GRAFO[nodo].items():
            nuevo_costo = costo + peso
            nueva_vis   = visitados | {vecino}
            if (nuevo_costo < dist[vecino][nueva_vis]
                    and nuevo_costo < mejor_rep[1]):
                dist[vecino][nueva_vis] = nuevo_costo
                heapq.heappush(
                    heap,
                    (nuevo_costo, vecino, nueva_vis, camino + [vecino])
                )

    return mejor_rep


